# Copy this file to .env and fill it in.  .env is gitignored: NEVER commit it.
# Use a fresh wallet that only ever holds testnet funds.

PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY

# RPC for deploying. Public works; Alchemy is more reliable.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY

# Etherscan API key (one key works for Polygonscan via Etherscan API V2). Needed for --verify.
ETHERSCAN_API_KEY=

# The three payout admins. Must be three DIFFERENT addresses. ADMIN1 defaults to the deployer.
# ADMIN1=
ADMIN2=
ADMIN3=

# Optional overrides (all default to the deployer / Circle's Amoy USDC / 1,000 USDC)
# TIMELOCK_CANCELLER=
# TIMELOCK_EXECUTOR=
# REGISTRY_PROPOSER=
# USDC_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
# FUNDRAISING_TARGET=1000000000

# Optional: queue a first vendor at deploy time (registration takes 48 real hours)
# DEMO_VENDOR=
# DEMO_VENDOR_NAME=School Supplies Co
